<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_live_screen">

    <com.riyas.SpideyAssistant.LiveWaveView
        android:id="@+id/liveWaveView"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_gravity="bottom"
        android:importantForAccessibility="no"
        android:clickable="false"
        android:focusable="false" />

    <!-- Decorative web corner, purely cosmetic -->
    <ImageView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="top|end"
        android:alpha="0.6"
        android:src="@drawable/web_corner"
        android:visibility="gone"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="8dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_spidey_mark"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE"
                    android:textColor="@color/spidey_white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready."
                    android:textColor="#D8DDF5"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_toggle_track"
                android:orientation="horizontal"
                android:padding="3dp">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/modeToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/voiceModeButton"
                        style="@style/ToggleButtonSpidey"
                        android:layout_width="38dp"
                        android:layout_height="match_parent"
                        android:minWidth="0dp"
                        android:padding="6dp"
                        android:contentDescription="Voice mode"
                        android:tooltipText="Voice mode"
                        app:icon="@drawable/ic_mic"
                        app:iconTint="@color/toggle_text_color"
                        android:checked="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/textModeButton"
                        style="@style/ToggleButtonSpidey"
                        android:layout_width="38dp"
                        android:layout_height="match_parent"
                        android:minWidth="0dp"
                        android:padding="6dp"
                        android:contentDescription="Text mode"
                        android:tooltipText="Text mode"
                        app:icon="@drawable/ic_keyboard"
                        app:iconTint="@color/toggle_text_color" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="AI provider settings"
                android:tooltipText="AI provider settings" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="0dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chatRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="18dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/voiceHintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Tap or talk to interrupt Spidey"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/voiceCaptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            android:text="" />

        <!-- TEXT MODE input bar -->
        <LinearLayout
            android:id="@+id/textInputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_composer"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/inputBox"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="center_vertical"
                android:hint="Message Spidey..."
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:inputType="textMultiLine"
                android:imeOptions="actionSend"
                android:maxLines="4"
                android:minHeight="48dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_send_button"
                android:src="@drawable/ic_send"
                android:padding="11dp"
                app:tint="@color/spidey_white"
                android:enabled="false"
                android:contentDescription="Send" />

        </LinearLayout>

        <!-- VOICE MODE controls -->
        <LinearLayout
            android:id="@+id/voiceInputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingBottom="18dp"
            android:paddingTop="4dp"
            android:visibility="visible">

            <ImageButton
                android:id="@+id/micButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_live_mic_button"
                android:src="@drawable/ic_mic"
                android:padding="20dp"
                android:contentDescription="Tap to speak"
                android:enabled="false" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
