<resources>
    <style name="Theme.SpideyAssistant" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/spidey_red</item>
        <item name="colorPrimaryDark">@color/spidey_black</item>
        <item name="colorAccent">@color/spidey_blue</item>
        <item name="android:windowBackground">@color/spidey_black</item>
        <item name="android:statusBarColor">@color/spidey_black</item>
        <item name="android:navigationBarColor">@color/spidey_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ToggleButtonSpidey" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/toggle_text_color</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">@color/toggle_bg_color</item>
        <item name="cornerRadius">16dp</item>
        <item name="rippleColor">@color/spidey_white</item>
    </style>
</resources>
